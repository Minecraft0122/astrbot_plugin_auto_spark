{
  "enabled": {"description":"启用自动续火","type":"bool","default":true},
  "interval_seconds": {"description":"续火间隔（秒）","type":"int","default":3600,"hint":"最小 10 秒"},
  "message": {"description":"发送的续火消息","type":"string","default":"续火啦 🔥"},
